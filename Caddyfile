# ============================================================
# Caddyfile —— HTTPS/SSL 自动终止 + 反向代理
#
# Caddy 自动申请 Let's Encrypt 证书,
# 通过 DOMAIN 环境变量设置域名,
# 本地调试默认使用 localhost
# ============================================================

{$DOMAIN:localhost} {
    reverse_proxy frontend:80
    encode gzip
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
}
